# Database
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha

# JWT
JWT_SECRET=chave_com_no_minimo_32_caracteres

# Criptografia de dados em repouso (AUD-008)
APP_ENCRYPTION_KEY=chave_aes_256_base64_gerada_com_segredo_proprio

# R2 Storage (Cloudflare)
STORAGE_ENDPOINT=https://seu-endpoint.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=sua_access_key
STORAGE_SECRET_KEY=sua_secret_key
STORAGE_BUCKET=minimoda-images
STORAGE_PUBLIC_URL=https://seu-dominio-publico.com

# Mercado Pago
MP_ACCESS_TOKEN=seu_access_token
MP_WEBHOOK_SECRET=seu_webhook_secret
MP_NOTIFICATION_URL=https://seu-dominio.com/payments/webhook

# Mail (SMTP)
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app

# Frontend / CORS
FRONTEND_URL=http://127.0.0.1:5500
CORS_ORIGINS=http://127.0.0.1:5500

# Segurança
TRUSTED_PROXIES=

# HTTP clients (timeouts)
HTTP_CONNECT_TIMEOUT_MS=5000
HTTP_READ_TIMEOUT_MS=10000

# Correios
CORREIOS_API_BASE_URL=https://api.correios.com.br
CORREIOS_USUARIO=seu_usuario_correios
CORREIOS_CODIGO_ACESSO=seu_codigo_acesso
CORREIOS_CARTAO_POSTAGEM=seu_cartao_postagem
CORREIOS_NUMERO_CONTRATO=seu_numero_contrato

# Bling
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
BLING_CLIENT_ID=seu_client_id
BLING_CLIENT_SECRET=seu_client_secret
BLING_REDIRECT_URI=https://seu-dominio.com/bling/callback
BLING_AUTHORIZE_URL=https://www.bling.com.br/Api/v3/oauth/authorize
